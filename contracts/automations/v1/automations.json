{
  "contract": "urn:empire:contracts:automations:v1",
  "description": "Automation identities for the Solo Empire task writers. Scopes come from what each writer actually does (SQLite statements audited 2026-10-09); a writer never gets the workspace owner's full rights.",
  "delegation_days": 30,
  "automations": [
    {"id": "task-sync", "writers": ["infra/go/task-sync/resolve.go", "infra/go/task-sync/sync.go"],
     "does": "upserts tasks from Todoist/Leantime by external key, updates title and parent",
     "scopes": ["tasks.task:read", "tasks.task:write"]},
    {"id": "engagement-sync", "writers": ["infra/scripts/utils/engagement_tasks_sync.py"],
     "does": "creates or updates one task per engagement next action",
     "scopes": ["tasks.task:read", "tasks.task:write"]},
    {"id": "gmail-review-sync", "writers": ["infra/scripts/utils/gmail_review_task_sync.py"],
     "does": "creates or updates review tasks from the Gmail review queue",
     "scopes": ["tasks.task:read", "tasks.task:write"]},
    {"id": "email-pipeline", "writers": ["infra/scripts/sync/email_data_pipeline.py", "infra/scripts/sync/gmail_categorizer.py"],
     "does": "creates tasks from classified email",
     "scopes": ["tasks.task:read", "tasks.task:write"]},
    {"id": "sales-pipeline", "writers": ["infra/scripts/workflows/sales_pipeline.py"],
     "does": "creates or updates follow-up tasks for deals",
     "scopes": ["tasks.task:read", "tasks.task:write"]},
    {"id": "decision-review", "writers": ["infra/scripts/workflows/decision_review.py"],
     "does": "creates a review task for each due decision",
     "scopes": ["tasks.task:read", "tasks.task:write"]},
    {"id": "role-evidence", "writers": ["infra/scripts/utils/role_practice_evidence.py"],
     "does": "appends practice evidence to task notes and may move a task to in_progress",
     "scopes": ["tasks.task:read", "tasks.task:write"]},
    {"id": "portfolio-seeder", "writers": ["infra/scripts/db/seed_finance_roadmap.py", "infra/scripts/utils/autonomous_portfolio_seed.py",
                                           "infra/scripts/utils/portfolio_context_seed.py", "infra/scripts/utils/role_portfolio_seed.py"],
     "does": "manually run seeds that create or refresh planned tasks",
     "scopes": ["tasks.task:read", "tasks.task:write"]},
    {"id": "recurring-gen", "writers": ["infra/scripts/utils/recurring_gen.py"],
     "does": "creates due instances of recurring tasks",
     "scopes": ["tasks.task:read", "tasks.occurrence:write"]},
    {"id": "reminder-worker", "writers": ["infra/scripts/utils/notification_runner.py", "infra/services/notifier/internal/db/db.go"],
     "does": "reads due reminders and records each delivery once",
     "scopes": ["tasks.task:read", "tasks.reminder:write"]},
    {"id": "overdue-reconciler", "writers": ["infra/scripts/sync/reconcile_overdue_tasks.py"],
     "does": "moves overdue due dates, cancels or completes tasks, and archives old completed tasks (never deletes)",
     "scopes": ["tasks.task:read", "tasks.status:write", "tasks.archive:write"]},
    {"id": "calendar-sync", "writers": ["infra/scripts/sync/sync_tasks_to_calendar.py"],
     "does": "stores the calendar event ID of a task",
     "scopes": ["tasks.task:read", "tasks.calendar:write"]}
  ],
  "not_automations": [
    {"writer": "infra/cli.ts", "decision": "human CLI; uses the owner's own token"},
    {"writer": "infra/scripts/cli/decision-cli.py", "decision": "human CLI; uses the owner's own token"},
    {"writer": "infra/mcp-server/src/tools/tasks.ts", "decision": "retire: replaced by the empire-platform MCP adapter"},
    {"writer": "services/today-api/server.py", "decision": "retire: replaced by the Tasks API once Today web calls it (P1.8)"}
  ]
}
