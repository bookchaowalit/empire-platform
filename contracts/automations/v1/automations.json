{
  "contract": "urn:empire:contracts:automations:v1",
  "description": "Automation identities for the Solo Empire task and decision writers. Scopes come from what each writer actually does (SQLite statements audited 2026-10-09); a writer never gets the workspace owner's full rights.",
  "delegation_days": 30,
  "automations": [
    {
      "id": "task-sync",
      "writers": [
        "infra/go/task-sync/resolve.go",
        "infra/go/task-sync/sync.go"
      ],
      "does": "upserts tasks from Todoist/Leantime by external key, updates title and parent",
      "scopes": [
        "tasks.task:read",
        "tasks.task:write"
      ]
    },
    {
      "id": "engagement-sync",
      "writers": [
        "infra/scripts/utils/engagement_tasks_sync.py"
      ],
      "does": "creates or updates one task per engagement next action",
      "scopes": [
        "tasks.task:read",
        "tasks.task:write"
      ]
    },
    {
      "id": "gmail-review-sync",
      "writers": [
        "infra/scripts/utils/gmail_review_task_sync.py"
      ],
      "does": "creates or updates review tasks from the Gmail review queue; links the review task to its goal and project, assigns the owner role, suggests the role",
      "scopes": [
        "tasks.task:read",
        "tasks.task:write",
        "tasks.link:write",
        "tasks.assignment:write",
        "tasks.suggestion:write"
      ]
    },
    {
      "id": "email-pipeline",
      "writers": [
        "infra/scripts/sync/email_data_pipeline.py",
        "infra/scripts/sync/gmail_categorizer.py"
      ],
      "does": "creates tasks from classified email",
      "scopes": [
        "tasks.task:read",
        "tasks.task:write"
      ]
    },
    {
      "id": "sales-pipeline",
      "writers": [
        "infra/scripts/workflows/sales_pipeline.py"
      ],
      "does": "creates or updates follow-up tasks for deals",
      "scopes": [
        "tasks.task:read",
        "tasks.task:write"
      ]
    },
    {
      "id": "decision-review",
      "writers": [
        "infra/scripts/workflows/decision_review.py"
      ],
      "does": "creates a review task for each due decision",
      "scopes": [
        "decisions.decision:read",
        "decisions.decision:write",
        "decisions.review:write",
        "tasks.task:read",
        "tasks.task:write"
      ]
    },
    {
      "id": "role-evidence",
      "writers": [
        "infra/scripts/utils/role_practice_evidence.py"
      ],
      "does": "appends practice evidence to task notes and may move a task to in_progress",
      "scopes": [
        "tasks.task:read",
        "tasks.task:write"
      ]
    },
    {
      "id": "portfolio-seeder",
      "writers": [
        "infra/scripts/db/seed_finance_roadmap.py",
        "infra/scripts/utils/autonomous_portfolio_seed.py",
        "infra/scripts/utils/portfolio_context_seed.py",
        "infra/scripts/utils/role_portfolio_seed.py"
      ],
      "does": "manually run seeds that create or refresh planned tasks; links seeded tasks to goals, projects, and contexts and assigns roles",
      "scopes": [
        "tasks.task:read",
        "tasks.task:write",
        "tasks.link:write",
        "tasks.assignment:write"
      ]
    },
    {
      "id": "recurring-gen",
      "writers": [
        "infra/scripts/utils/recurring_gen.py"
      ],
      "does": "creates due instances of recurring tasks",
      "scopes": [
        "tasks.task:read",
        "tasks.occurrence:write"
      ]
    },
    {
      "id": "reminder-worker",
      "writers": [
        "infra/scripts/utils/notification_runner.py",
        "infra/services/notifier/internal/db/db.go"
      ],
      "does": "reads due reminders and records each delivery once",
      "scopes": [
        "tasks.task:read",
        "tasks.reminder:write"
      ]
    },
    {
      "id": "overdue-reconciler",
      "writers": [
        "infra/scripts/sync/reconcile_overdue_tasks.py"
      ],
      "does": "moves overdue due dates, cancels or completes tasks, and archives old completed tasks (never deletes)",
      "scopes": [
        "tasks.task:read",
        "tasks.status:write",
        "tasks.archive:write"
      ]
    },
    {
      "id": "calendar-sync",
      "writers": [
        "infra/scripts/sync/sync_tasks_to_calendar.py"
      ],
      "does": "stores the calendar event ID of a task",
      "scopes": [
        "tasks.task:read",
        "tasks.calendar:write"
      ]
    },
    {
      "id": "role-router",
      "writers": [
        "infra/scripts/utils/role_task_workflow.py",
        "infra/scripts/utils/role_task_mapper.py",
        "infra/scripts/utils/role_integration_sync.py"
      ],
      "does": "suggests roles and skills for tasks, accepts routed suggestions, and assigns roles; never edits the task itself",
      "scopes": [
        "tasks.task:read",
        "tasks.link:write",
        "tasks.assignment:write",
        "tasks.suggestion:write"
      ]
    },
    {
      "id": "reporting-reader",
      "readers": [
        "infra/scripts/utils/daily_snapshot.py",
        "infra/scripts/workflows/daily_diary.py",
        "infra/scripts/workflows/diary_summary.py",
        "infra/scripts/workflows/daily_briefing.py",
        "infra/scripts/utils/dashboard_refresh.py",
        "infra/scripts/utils/system_status.py",
        "infra/scripts/utils/system_health.py",
        "infra/scripts/sync/task_email_digest.py",
        "infra/scripts/utils/alerts.py",
        "infra/scripts/utils/tasks_view.py",
        "infra/scripts/workflows/decision_engine.py",
        "infra/scripts/utils/task_calendar_health.py"
      ],
      "does": "reads tasks and counts for briefings, diaries, digests, alerts, and status reports",
      "scopes": [
        "decisions.decision:read",
        "tasks.task:read"
      ]
    },
    {
      "id": "governance-reader",
      "readers": [
        "infra/scripts/utils/role_task_guard.py",
        "infra/scripts/utils/portfolio_context_guard.py",
        "infra/scripts/utils/operating_model_guard.py",
        "infra/scripts/quality/finance_production_preflight.py",
        "infra/scripts/utils/function_share.py",
        "infra/scripts/utils/data_fixer.py",
        "infra/scripts/utils/role_system_coverage_guard.py"
      ],
      "does": "reads tasks, links, assignments, and suggestions to check integrity rules",
      "scopes": [
        "decisions.decision:read",
        "tasks.task:read"
      ]
    },
    {
      "id": "portfolio-reader",
      "readers": [
        "infra/scripts/workflows/update_goal_progress.py",
        "infra/scripts/utils/season_quest.py",
        "infra/scripts/utils/entity_graph_sync.py",
        "infra/scripts/workflows/knowledge_atlas.py",
        "infra/scripts/workflows/domain_enrichment.py",
        "infra/scripts/workflows/portfolio_domain_loop.py",
        "infra/scripts/workflows/book_dev_loop.py",
        "infra/scripts/utils/ai_cycle.py"
      ],
      "does": "reads tasks and their goal and project links to compute progress and plan work",
      "scopes": [
        "tasks.task:read"
      ]
    },
    {
      "id": "engagement-reader",
      "readers": [
        "infra/scripts/utils/engagement_review.py",
        "infra/scripts/utils/engagement_notifications.py",
        "services/crm-api/crm_workflow_evidence.py"
      ],
      "does": "reads tasks referenced by engagements and CRM evidence",
      "scopes": [
        "decisions.decision:read",
        "tasks.task:read"
      ]
    },
    {
      "id": "dashboard-api",
      "readers": [
        "infra/dashboard/server.ts",
        "infra/mcp-server/src/tools/performance.ts",
        "infra/mcp-server/src/tools/customization.ts"
      ],
      "does": "serves task lists and counts to the local dashboard and the legacy MCP stats tools",
      "scopes": [
        "decisions.decision:read",
        "tasks.task:read"
      ]
    },
    {
      "id": "progress-rollup",
      "writers": [
        "infra/scripts/utils/portfolio_progress.py"
      ],
      "does": "rolls subtask progress up into each task's progress_percent and reads goal and project links for the progress report",
      "scopes": [
        "tasks.task:read",
        "tasks.status:write"
      ]
    },
    {
      "id": "today-web",
      "writers": [
        "services/today-api/server.py"
      ],
      "does": "serves the Today web view and applies its status, priority, progress, due date, and time edits",
      "scopes": [
        "tasks.task:read",
        "tasks.task:write",
        "tasks.status:write"
      ]
    },
    {
      "id": "legacy-mcp",
      "writers": [
        "infra/mcp-server/src/tools/tasks.ts"
      ],
      "does": "the Solo Empire MCP task tools used by agents for the owner; delete_task archives instead of deleting",
      "scopes": [
        "decisions.decision:approve",
        "decisions.decision:read",
        "decisions.decision:write",
        "tasks.archive:write",
        "tasks.status:write",
        "tasks.task:read",
        "tasks.task:write"
      ]
    },
    {
      "id": "owner-cli",
      "writers": [
        "infra/cli.ts",
        "infra/scripts/cli/decision-cli.py"
      ],
      "does": "the owner's human CLIs (tasks add/done/update/list, decision review completion); read, create, update, and complete tasks; no archive, link, assignment, or delete",
      "scopes": [
        "decisions.decision:approve",
        "decisions.decision:delete",
        "decisions.decision:read",
        "decisions.decision:write",
        "decisions.review:write",
        "tasks.status:write",
        "tasks.task:read",
        "tasks.task:write"
      ]
    },
    {
      "id": "decision-engine",
      "writers": [
        "infra/scripts/workflows/decision_engine.py"
      ],
      "does": "proposes and refreshes decision records from signals, and clears ones whose signal is gone",
      "scopes": [
        "decisions.decision:read",
        "decisions.decision:write"
      ]
    },
    {
      "id": "paas-operator",
      "writers": [
        "infra/scripts/platform/paas_action.py",
        "infra/scripts/platform/paas_execute.py"
      ],
      "does": "records PaaS change proposals as decisions and claims an approved one before executing it",
      "scopes": [
        "decisions.decision:read",
        "decisions.decision:write"
      ]
    },
    {
      "id": "decisions-publisher",
      "writers": [
        "bookchaowalit/solo-decisions:src/solo_decisions/publisher.py"
      ],
      "does": "delivers the decisions outbox to the graph",
      "scopes": [
        "graph.decisions:write"
      ]
    }
  ],
  "not_automations": []
}
